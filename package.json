{
  "version": "4.4.7",
  "name": "antigravity-tools",
  "description": "Antigravity Tools",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"node orchestrator.cjs\" \"vite\"",
    "proxy": "node ../../Respaldos-y-Sync/mesh-shared-vault/sitio-descarga/server.js",
    "chat:backend": "npm --prefix ./microservices/antigravity-link-local run start:public",
    "hypervisor:backend": "npm --prefix ./microservices/omniverso-hypervisor run dev",
    "status:backend": "npm --prefix ./microservices/status.civer.cloud run dev",
    "nodriza:backend": "npm --prefix ./microservices/Nodriza-Core run dev:all",
    "omni:dashboard": "npm --prefix ./microservices/omni-drive-dashboard run dev -- -p 3006",
    "qr:backend": "npm --prefix ./microservices/qr-generator-system run dev -- --port 3007",
    "gptlab:backend": "cd ./microservices/gpt-5.4-mini-lab && set PORT=3008 && npm run dev",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:debug": "RUST_LOG=debug npm run tauri dev"
  },
