{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "Civer Cloud Manager",
    "version":  "5.2.0",
    "identifier":  "cloud.civer.manager",
    "build":  {
                  "beforeDevCommand":  "npm run dev",
                  "beforeBuildCommand":  "npm run build",
                  "frontendDist":  "../dist"
              },
    "app":  {
                "withGlobalTauri":  false,
                "windows":  [
                                {
                                    "title":  "Civer Cloud Manager",
                                    "width":  1024,
                                    "height":  700,
                                    "decorations":  true,
                                    "transparent":  false,
                                    "maximized": true,
                                    "visible": true
                                }
                            ],
                "security":  {
                                 "csp":  "default-src \u0027self\u0027; img-src \u0027self\u0027 asset: data:; style-src \u0027self\u0027 \u0027unsafe-inline\u0027; script-src \u0027self\u0027 \u0027unsafe-inline\u0027; connect-src ipc: http://ipc.localhost"
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  [
                                   "nsis"
                               ],
                   "createUpdaterArtifacts":  true,
                   "resources":  [
                                     "assets/ai_brain/**/*",
                                     "assets/cloud_accounts.db"
                                 ],
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.icns",
                                "icons/icon.ico"
                            ],
                   "macOS":  {
                                 "entitlements":  "Entitlements.plist"
                             }
               },
    "plugins":  {
                    "updater":  {
                                    "active":  true,
                                    "endpoints":  [
                                                      "https://github.com/pablo-arboleadi/Civer-Cloud-Manager/releases/latest/download/updater.json"
                                                  ],
                                    "pubkey":  "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc2NTVGODlBQTRBNDU5QTEKUldTaFdhU2ttdmhWZHNkTFBONXhTQUxEWUlHWUkvVU1Kb1dzR0ZhU3RjQXM1RzdlMVlyZkNybWoK",
                                    "dialog":  true
                                },
                    "process":  null,
                    "fs":  null,
                    "dialog":  null,
                    "opener":  null,
                    "single-instance":  null
                }
}
