{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Civer Cloud Manager IDE 5.1 (Bootstrapper & Zero-Friction UAC)",
  "version": "5.1.0",
  "identifier": "cloud.civer.manager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Antigravity Manager Civer Cloud",
        "width": 1024,
        "height": 700,
        "decorations": true,
        "transparent": false,
        "maximized": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": [
      "assets/ai_brain/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "Entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/pablo-arboleadi/Antigravity-Manager/releases/latest/download/updater.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc2NTVGODlBQTRBNDU5QTEKUldTaFdhU2ttdmhWZHNkTFBONXhTQUxEWUlHWUkvVU1Kb1dzR0ZhU3RjQXM1RzdlMVlyZkNybWoK",
      "dialog": true
    },
    "process": null,
    "fs": null,
    "dialog": null,
    "opener": null,
    "single-instance": null
  }
}
